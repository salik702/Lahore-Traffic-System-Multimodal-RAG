# Backend
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
RAG_ENABLED=true
RAG_PARSER=mineru
RAG_QUERY_MODE=hybrid
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=
EMBEDDING_DIMENSION=768
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=8

# Optional compatible local models / reviewed calibration policy; defaults use
# backend/models and conservative, uncalibrated settings. Restart after changes.
# VEHICLE_MODEL_PATH=
# HELMET_MODEL_PATH=
# POSE_MODEL_PATH=
# PLATE_MODEL_PATH=
# VISION_POLICY_PATH=

# Frontend (copy to frontend/.env.local if the API is not local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
