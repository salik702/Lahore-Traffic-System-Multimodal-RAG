# Backend
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Must be a vision-capable model your Groq account can actually reach. When the
# configured model is unavailable the indexer falls back to caption-only text
# from the source document and never invents a visual description.
GROQ_VISION_MODEL=qwen/qwen3.6-27b
RAG_ENABLED=true
# mineru    - use MinerU when its CLI supports RAG-Anything's legacy flags,
#             otherwise fall back to the built-in pymupdf parser automatically.
# pymupdf   - always use the built-in PyMuPDF + offline OCR parser.
RAG_PARSER=mineru
RAG_QUERY_MODE=hybrid
# Groq reasoning models can answer with an empty completion. "low" keeps the
# JSON extraction on the output side instead of spending the budget reasoning.
RAG_LLM_REASONING_EFFORT=low
RAG_LLM_MAX_RETRIES=3
# Extraction concurrency for live API traffic. scripts/ingest_rag_documents.py
# raises this for the bulk load via the RAG_LLM_MAX_ASYNC environment variable.
RAG_LLM_MAX_ASYNC=1
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=
EMBEDDING_DIMENSION=768
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=8

# Optional compatible local models / reviewed calibration policy; defaults use
# backend/models and conservative, uncalibrated settings. Restart after changes.
# VEHICLE_MODEL_PATH=
# HELMET_MODEL_PATH=
# POSE_MODEL_PATH=
# PLATE_MODEL_PATH=
# VISION_POLICY_PATH=

# Frontend (copy to frontend/.env.local if the API is not local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
